# Managed by ai-support-agent (zabbix_webhook_relay). Loopback-only Zabbix webhook relay.
# Zabbix HttpRequest does not verify TLS certificates and follows redirects; this server
# verifies the upstream certificate and converts upstream redirects into 502.
server {
    listen 127.0.0.1:{{ zabbix_webhook_relay_listen_port }};
    server_name "";
    access_log /var/log/nginx/ai-support-zabbix-webhook-relay.access.log;
    error_log /var/log/nginx/ai-support-zabbix-webhook-relay.error.log warn;
    client_max_body_size 4k;
    client_body_buffer_size 4k;

    location ~ "^/webhooks/zabbix/[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}/[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" {
        limit_except POST {
            deny all;
        }
        # Send only the normalized path that matched the location above, without the query.
        # proxy_pass without a URI part would otherwise forward the raw request URI.
        rewrite ^ $uri? break;
        proxy_pass https://{{ zabbix_webhook_relay_upstream_host }}:{{ zabbix_webhook_relay_upstream_port }};
        proxy_http_version 1.1;
        proxy_set_header Host {{ zabbix_webhook_relay_upstream_host }}{{ '' if (zabbix_webhook_relay_upstream_port | int) == 443 else ':' ~ zabbix_webhook_relay_upstream_port }};
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name {{ zabbix_webhook_relay_upstream_host }};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_redirect off;
        proxy_intercept_errors on;
        error_page 300 301 302 303 305 307 308 =502 /ai-support-relay-upstream-redirect;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    location = /ai-support-relay-upstream-redirect {
        internal;
        return 502;
    }

    location / {
        return 404;
    }
}
