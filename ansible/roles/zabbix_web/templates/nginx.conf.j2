# Managed by ai-support-agent. Separate from other sites and the default vhost.
server {
    listen {{ (zabbix_web_listen_address ~ ':') if zabbix_web_listen_address else '' }}{{ zabbix_web_listen_port }};
    server_name {{ zabbix_web_server_name }};
    root {{ zabbix_web_ui_root }};
    index index.php;
    client_max_body_size 16m;
    location / {
        try_files $uri $uri/ =404;
    }
    location ~ ^/(api|conf|include|locale|vendor)/ {
        deny all;
    }
    location ~ /\. {
        deny all;
    }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/ai-support-zabbix.sock;
        fastcgi_read_timeout 300;
    }
}
{% if (zabbix_web_mbc_pull | default({})).enabled | default(false) %}
# SCIM, used only by the MBC PULL sync (ai-support-zabbix-mbc-pull) on this host. A separate listener on
# 127.0.0.1 only: a reverse proxy in front of the frontend port never reaches it (do not forward to this port).
server {
    listen 127.0.0.1:{{ zabbix_web_mbc_pull.scim_port | int }};
    server_name {{ zabbix_web_server_name }};
    root {{ zabbix_web_ui_root }};
    location ^~ /api_scim.php/ {
        allow 127.0.0.1;
        deny all;
        fastcgi_split_path_info ^(/api_scim\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api_scim.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_pass unix:/run/php/ai-support-zabbix.sock;
    }
    location / {
        return 404;
    }
}
{% endif %}
