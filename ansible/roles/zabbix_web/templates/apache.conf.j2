# Managed by ai-support-agent. Dedicated listener and named virtual host.
Listen {{ zabbix_web_listen_port }}
<VirtualHost *:{{ zabbix_web_listen_port }}>
    ServerName {{ zabbix_web_server_name }}
    DocumentRoot {{ zabbix_web_ui_root }}
    DirectoryIndex index.php
    <Directory {{ zabbix_web_ui_root }}>
        Require all granted
        AllowOverride None
    </Directory>
    <DirectoryMatch "{{ zabbix_web_ui_root }}/(api|conf|include|locale|vendor)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/ai-support-zabbix.sock|fcgi://localhost/"
    </FilesMatch>
</VirtualHost>

