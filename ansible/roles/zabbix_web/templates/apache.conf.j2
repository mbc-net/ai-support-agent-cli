# Managed by ai-support-agent. Dedicated listener and named virtual host.
Listen {{ zabbix_web_listen_port }}
<VirtualHost *:{{ zabbix_web_listen_port }}>
    ServerName {{ zabbix_web_server_name }}
    DocumentRoot {{ zabbix_web_ui_root }}
    DirectoryIndex index.php
    <Directory {{ zabbix_web_ui_root }}>
        Require all granted
        AllowOverride None
    </Directory>
    <DirectoryMatch "{{ zabbix_web_ui_root }}/(api|conf|include|locale|vendor)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/ai-support-zabbix.sock|fcgi://localhost/"
    </FilesMatch>
    # SCIM is served only by the nginx loopback server of the MBC PULL sync. Zabbix also takes the SCIM endpoint from
    # a client "Path-Info" request header, so /api_scim.php stays closed here, also after a run that disables the
    # sync and switches to Apache while SCIM is still on.
    <LocationMatch "^/api_scim\.php">
        Require all denied
    </LocationMatch>
</VirtualHost>

